# Copy to ~/.nifty_forecast_env and chmod 600.
# Plain KEY=VALUE only: no "export", no quotes, no spaces around "=" (systemd rejects them).

# Same read-only Analytics Token the EMA bot uses. COPY the value; do not generate a new
# token in Upstox, because that revokes the one the bot is using.
UPSTOX_ANALYTICS_TOKEN=

# A NEW bot from @BotFather, not the EMA bot's token. Press Start on the new bot once.
TELEGRAM_BOT_TOKEN=
# Your own chat id. It is the same number you already use for the EMA bot.
TELEGRAM_CHAT_ID=

# One LLM key is enough. With none set, the agent uses its keyword list.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional. Leave empty to auto-pick from whichever key is set.
LLM_PROVIDER=
LLM_MODEL=
